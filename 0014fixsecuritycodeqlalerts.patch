From e253d3955f9db3807889983793305c8b4f103044 Mon Sep 17 00:00:00 2001
From: Siyuan Feng <sealseacat@gmail.com>
Date: Sun, 23 Aug 2026 23:01:33 +0000
Subject: [PATCH] fix(security): resolve both CodeQL warning-level alerts
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two alerts from the security-and-quality suite, verified locally with the
CodeQL CLI (2.26.3) before and after — warning-level findings go 2 -> 0:

1. py/incomplete-url-substring-sanitization (high, 7.8) in the CLI
   data-egress test: `assert "api.openai.com" in result.output` is the
   shape of an incomplete URL sanitization check, and it would also pass
   for a look-alike destination such as "api.openai.com.evil.test". The
   test now parses the destination out of the warning and compares
   urlparse(...).netloc exactly — stricter than what it replaced.

2. actions/unpinned-tag (medium, 5.0) in the release workflow:
   pypa/gh-action-pypi-publish was used at the moving ref release/v1. That
   job holds id-token: write for PyPI trusted publishing, so a hijacked tag
   could publish to PyPI as us. Pinned to the commit SHA of v1.14.2;
   Dependabot (github-actions ecosystem, already configured) keeps it current.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HGpHiBWPWaqCJdPetpgMLk
---
 .github/workflows/release.yml |  5 ++++-
 tests/test_llm_config.py      | 10 +++++++++-
 2 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index c479faf..0181210 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -31,4 +31,7 @@ jobs:
       - name: Validate metadata
         run: twine check --strict dist/*
       - name: Publish to PyPI (trusted publishing)
-        uses: pypa/gh-action-pypi-publish@release/v1
+        # Pinned to a commit SHA, not a moving tag: this job holds
+        # id-token: write, so a hijacked tag could publish to PyPI as us.
+        # Dependabot (github-actions ecosystem) keeps the pin current.
+        uses: pypa/gh-action-pypi-publish@a892a5a61159132606e93a2fa6f4358831b04d26  # v1.14.2
diff --git a/tests/test_llm_config.py b/tests/test_llm_config.py
index 5c5362a..7f155e5 100644
--- a/tests/test_llm_config.py
+++ b/tests/test_llm_config.py
@@ -12,7 +12,9 @@ Two bugs and one missing control:
 """
 from __future__ import annotations
 
+import re
 from collections.abc import Sequence
+from urllib.parse import urlparse
 
 import pytest
 
@@ -128,7 +130,13 @@ def test_cli_warns_before_sending_values_to_openai(cli_env):
     # actually be constructed in this environment (the openai package may be
     # missing) — it fires before any network client is built.
     assert "will be sent to" in result.output
-    assert "api.openai.com" in result.output
+    # Compare the parsed host, not a substring of the URL: a bare
+    # `"host" in text` check is the shape of an incomplete URL sanitization
+    # (CodeQL py/incomplete-url-substring-sanitization), and it would also
+    # pass for a look-alike destination like "api.openai.com.evil.test".
+    destination = re.search(r"will be sent to (\S+)", result.output)
+    assert destination is not None, result.output
+    assert urlparse(destination.group(1).rstrip(".")).netloc == "api.openai.com"
 
 
 def test_cli_metadata_only_warning_mentions_no_values(cli_env):
