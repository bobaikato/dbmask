diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index f6d4065..d39e798 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -8,7 +8,28 @@ on:
 permissions:
   contents: read
 
+concurrency:
+  group: ci-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
 jobs:
+  lint:
+    name: lint + types (ruff, mypy)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: Install package with dev extras
+        run: |
+          python -m pip install --upgrade pip
+          pip install -e ".[dev]"
+      - name: Ruff
+        run: ruff check src/ tests/ examples/
+      - name: Mypy
+        run: mypy
+
   test:
     name: test (py${{ matrix.python }}, ${{ matrix.os }})
     runs-on: ${{ matrix.os }}
@@ -33,6 +54,41 @@ jobs:
       - name: Run tests
         run: pytest -q
 
+  coverage:
+    name: coverage gate (>= 80%)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: Install package with dev extras
+        run: |
+          python -m pip install --upgrade pip
+          pip install -e ".[dev]"
+      - name: Run tests with coverage
+        run: pytest --cov=dbmask --cov-report=term --cov-fail-under=80
+
+  audit:
+    name: dependency audit (pip-audit)
+    runs-on: ubuntu-latest
+    # Advisory for now: new upstream CVEs shouldn't block unrelated PRs,
+    # but the report stays visible on every run.
+    continue-on-error: true
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: Install runtime dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install .
+      - name: pip-audit
+        run: |
+          pip install pip-audit
+          pip-audit
+
   build:
     name: build + twine check
     runs-on: ubuntu-latest
