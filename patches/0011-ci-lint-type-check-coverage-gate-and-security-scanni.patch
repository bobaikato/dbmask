@@ -73,3 +83,38 @@ where = ["src"]
 
 [tool.setuptools.package-data]
 dbmask = ["py.typed", "masking/dictionaries/data/*.txt"]
+
+# ---------------------------------------------------------------------------
+# Tooling
+# ---------------------------------------------------------------------------
+
+[tool.ruff]
+target-version = "py39"
+line-length = 100
+
+[tool.ruff.lint]
+select = ["E", "F", "W", "I", "B", "UP"]
+ignore = [
+    "E501",   # long lines: docs/tables read better unwrapped
+    "UP007",  # keep Optional[X] spelling while 3.9 is supported
+    "UP045",
+]
+
+[tool.mypy]
+python_version = "3.9"
+files = ["src/dbmask"]
+ignore_missing_imports = true
+warn_redundant_casts = true
+warn_unused_ignores = false  # ignores differ between local/CI stub sets
+no_implicit_optional = true
+
+[tool.pytest.ini_options]
+testpaths = ["tests"]
+addopts = "-q"
+
+[tool.coverage.run]
+source = ["dbmask"]
+
+[tool.coverage.report]
+show_missing = false
+precision = 0
