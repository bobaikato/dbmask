@@ -0,0 +1,34 @@
+# This CITATION.cff file was generated so that dbmask can be cited in
+# academic and technical work. GitHub renders a "Cite this repository"
+# button from it; Zenodo reads it when archiving releases.
+#
+# After the first Zenodo archive is created, add its concept DOI here:
+#   doi: 10.5281/zenodo.XXXXXXX
+cff-version: 1.2.0
+message: "If you use dbmask in your work, please cite it as below."
+type: software
+title: "dbmask: discover, mask, and validate sensitive data in SQL databases"
+abstract: >-
+  An open-source Python toolkit that discovers sensitive columns in SQL
+  databases (pattern heuristics, manual overrides, optional LLM fallback),
+  masks them with deterministic, referentially-consistent fake values, and
+  validates afterwards that the masking actually happened — one auditable
+  workflow for producing safe copies of production data.
+authors:
+  - family-names: "Feng"
+    given-names: "Siyuan"
+    email: "sealseacat@gmail.com"
+version: "0.1.1"
+date-released: "2026-08-21"
+license: MIT
+repository-code: "https://github.com/sealandseacat/dbmask"
+url: "https://github.com/sealandseacat/dbmask"
+keywords:
+  - data-masking
+  - anonymization
+  - pii
+  - privacy
+  - test-data
+  - gdpr
+  - sqlalchemy
+  - etl
