+  # enabled: true
+  # provider: local
+  # model: qwen2.5-7b-instruct
+  # base_url: http://localhost:1234
+  # api_style: openai        # local provider only: ollama (default) | openai
+
 # --- 5. Masking / ETL --------------------------------------------------------
