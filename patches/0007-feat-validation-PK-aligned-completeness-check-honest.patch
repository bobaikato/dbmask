-                        schema, table, comparable, column, value, cfg.max_rows_per_value
-                    )
-                }
-                identical = src_rows & tgt_rows
-                if identical:
-                    unmasked_rows += len(identical)
-                    if len(samples) < 5:
-                        samples.append(value)
-                    if unmasked_rows >= cfg.unmasked_evidence_threshold:
