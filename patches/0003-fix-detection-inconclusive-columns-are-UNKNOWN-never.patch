 src/dbmask/cli.py                |  31 ++++++++-
 src/dbmask/detection/pipeline.py |  30 +++++++--
 src/dbmask/runner.py             |   7 ++
 tests/test_unknown_detection.py  | 108 +++++++++++++++++++++++++++++++
 5 files changed, 200 insertions(+), 9 deletions(-)
